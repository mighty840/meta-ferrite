# /etc/ferrite/gateway.env: ferrite-gateway settings, read by
# ferrite-gateway.service as an EnvironmentFile (KEY=value, no quotes needed).

# ferrite-server base URL.
FERRITE_SERVER_URL=https://ferrite.example.com

# Sent as X-API-Key; required when the server sets INGEST_API_KEY.
#INGEST_API_KEY=

# Only if the server sits behind HTTP basic auth.
#BASIC_AUTH_USER=
#BASIC_AUTH_PASS=

# Serial ports to read, comma-separated. 99-ferrite.rules creates stable
# names such as /dev/ferrite-nucleo-l4 or /dev/ferrite-usb0.
#USB_PORTS=/dev/ferrite-usb0

# Forwarding attempts per batch before it stays in the offline buffer.
#GATEWAY_MAX_RETRIES=3

# Extra command-line options (see `ferrite-gateway --help`), for example:
#   --ble                     scan for BLE devices (needs bluetoothd)
#   --usb-baud 921600         serial baud rate (default 115200)
#   --http-ingest-port 0      disable the HTTP ingest port (default 4001)
GATEWAY_ARGS=
